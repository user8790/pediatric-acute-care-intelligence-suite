{
  "name": "pediatric-acute-care-intelligence-suite",
  "private": true,
  "version": "0.1.0",
  "description": "Synthetic pediatric acute care operations intelligence prototype.",
  "scripts": {
    "dev:showcase": "pnpm --dir apps/showcase dev",
    "build:showcase": "pnpm --dir apps/showcase build",
    "test:showcase:e2e": "pnpm --dir apps/showcase test:e2e",
    "test:py": "python -m pytest",
    "generate:data": "python packages/synthetic/generate_synthetic_data.py && python packages/synthetic/generate_v3_frontier_data.py && python packages/synthetic/generate_v5_command_center_data.py",
    "generate:v3": "python packages/synthetic/generate_v3_frontier_data.py",
    "generate:v5": "python packages/synthetic/generate_v5_command_center_data.py"
  },
  "workspaces": [
    "apps/showcase"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@11.0.8"
}
